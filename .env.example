# Copy this file to .env and paste your key(s). Never put real keys in this file.

# Anthropic Claude key (https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=paste-your-key-here

# Google Gemini key (https://aistudio.google.com → Get API key)
GEMINI_API_KEY=paste-your-key-here

# OpenAI API key (https://platform.openai.com → API keys)
OPENAI_API_KEY=paste-your-key-here

# Which AI model runs the Ask AI tab: claude, gemini or openai
LLM_PROVIDER=claude

# Optional: override the model names (defaults: claude-opus-5-5, gemini-3.8-flash, gpt-6.1-terra)
# CLAUDE_MODEL=claude-opus-5-5
# GEMINI_MODEL=gemini-3.8-flash
# OPENAI_MODEL=gpt-6.1-terra

# Optional: seconds to wait for one AI call before giving up (default 30)
# LLM_TIMEOUT_S=30
